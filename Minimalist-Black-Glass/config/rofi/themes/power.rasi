* {
    font: "JetBrainsMono Nerd Font Mono 22";
    bg: rgba(0, 0, 0, 0.62);
    surface: #000000;
    fg: #FFFFFF;
}

window {
    fullscreen: true;
    width: 100%;
    height: 100%;
    background-color: @bg;
    border: none;
    border-radius: 0;
}

mainbox {
    padding: 0;
    margin: 0;
    children: [ "listview" ];
    background-color: rgba(0, 0, 0, 0);
}

listview {
    lines: 4;
    columns: 1;
    fixed-height: false;
    scrollbar: false;
    spacing: 12px;
    padding: 0;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    dynamic: true;
}

element {
    padding: 22px 96px;
    background-color: rgba(0, 0, 0, 0);
    text-color: @fg;
    border-radius: 0;
}

element selected {
    background-color: #FFFFFF;
    border-color: #FFFFFF;
    text-color: #000000;
}

element-text {
    horizontal-align: 0.5;
}

element-icon {
    horizontal-align: 0.5;
}