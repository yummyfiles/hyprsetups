[Unit]
Description=Stoat black/white theme CSS injector (CDP)
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
Restart=on-failure
RestartSec=10
ExecStart=/usr/bin/env python3 /home/yummy.dev/.config/stoat-desktop/theme-inject.py
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target