{
  "manifest_version": 2,
  "name": "Yummyfiles Startpage",
  "version": "1.0.7",
  "description": "Themed startpage with Google search for new tabs (purple accents in private windows).",
  "incognito": "span",
  "browser_specific_settings": {
    "gecko": {
      "id": "startpage@yummy.dev",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "https://api.github.com/*"
  ],
  "browser_action": {
    "default_title": "Open startpage settings",
    "popup": "settings.html"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}