{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,
    "modules-left": ["custom/arch", "custom/brand", "custom/github", "custom/hyprsetups", "custom/incognito"],
    "modules-center": ["custom/media"],
    "modules-right": [
        "network",
        "bluetooth",
        "pulseaudio",
        "cpu",
        "memory",
        "temperature",
        "battery",
        "custom/notification",
        "custom/power"
    ],

    "custom/arch": {
        "format": "󰣇",
        "tooltip": false,
        "on-click": "sh /home/yummy.dev/.config/waybar/scripts/arch-show-desktop.sh"
    },

    "custom/media": {
        "format": "{}",
        "interval": 1,
        "exec": "python3 /home/yummy.dev/.config/waybar/scripts/media-or-clock.py",
        "on-click": "sh /home/yummy.dev/.config/waybar/scripts/media-or-clock.sh",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous",
        "tooltip": false
    },

    "custom/brand": {
        "format": "YUMMYFILES // DEV",
        "tooltip": false
    },

    "custom/github": {
        "format": "󰊤",
        "tooltip": false,
        "on-click": "xdg-open https://github.com/yummyfiles"
    },

    "custom/hyprsetups": {
        "format": "",
        "tooltip": false,
        "on-click": "xdg-open https://github.com/yummyfiles/hyprsetups"
    },

    "custom/incognito": {
        "format": "󰌒",
        "tooltip": false,
        "on-click": "firefox --private-window"
    },

    "custom/notification": {
        "format": "󰂚",
        "tooltip": false,
        "on-click": "sh /home/yummy.dev/.config/waybar/scripts/notification-center.sh"
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "sh /home/yummy.dev/.config/waybar/scripts/power-menu.sh"
    },

    "pulseaudio": {
        "format": "󰕾 {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "󰋋",
            "handsfree": "󰋋",
            "headset": "󰋋",
            "phone": "󰋋",
            "portable": "󰋋",
            "car": "󰋋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "sh ~/.config/waybar/scripts/volume-popup.py",
        "tooltip": false
    },

    "cpu": {
        "format": "󰻠 {usage}%",
        "tooltip": false
    },

    "memory": {
        "format": "󰍛 {}%",
        "tooltip": false
    },

    "temperature": {
        "critical-threshold": 80,
        "format": "󰔏 {temperatureC}°C",
        "tooltip": false
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "󰁹 {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰂄 {capacity}%",
        "format-alt": "{time} {icon}",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂"],
        "tooltip": false
    },

    "network": {
        "format-wifi": "󰖩",
        "format-ethernet": "󰈀 {ifname}",
        "format-disconnected": "󰖪",
        "tooltip": false,
        "on-click": "sh /home/yummy.dev/.config/waybar/scripts/wifi.sh"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂯 {device_alias}",
        "format-disconnected": "󰂲",
        "tooltip": false,
        "on-click": "sh /home/yummy.dev/.config/waybar/scripts/bluetooth.sh"
    }
}