{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "separator": " : ",
        "color": {
            "keys": "white",
            "title": "white",
            "separator": "white"
        }
    },
    "logo": {
        "type": "auto",
        "source": "arch_small",
        "color": {
            "1": "white",
            "2": "white",
            "3": "white"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}"
        },
        {
            "type": "separator",
            "format": "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"
        },
        {
            "type": "os",
            "key": "OS"
        },
        {
            "type": "kernel",
            "key": "KERNEL",
            "format": "{release}"
        },
        {
            "type": "uptime",
            "key": "UPTIME"
        },
        {
            "type": "shell",
            "key": "SHELL"
        },
        {
            "type": "desktopEnvironment",
            "key": "DE",
            "argument": "compact"
        },
        {
            "type": "wm",
            "key": "WM"
        },
        {
            "type": "terminal",
            "key": "TERM"
        },
        {
            "type": "cpu",
            "key": "CPU"
        },
        {
            "type": "gpu",
            "key": "GPU"
        },
        {
            "type": "memory",
            "key": "MEM"
        },
        {
            "type": "disk",
            "key": "DISK"
        }
    ]
}